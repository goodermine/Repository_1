# Auto-detect text files and normalize line endings to LF.
* text=auto

# Vendored binaries — never normalize line endings.
*.bin  binary
*.wasm binary
*.onnx binary

# Vendored third-party libraries & models: keep verbatim, exclude from
# GitHub language stats, and suppress diffs on the minified bundles.
vendor/**      linguist-vendored
vendor/*.min.js binary
